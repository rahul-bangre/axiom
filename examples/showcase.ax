// axiom language showcase

print("=== Axiom Language Showcase ===")
print()

// variables (immutable)
language = "Axiom"
version = 0.1
print("Language:", language, version)
print()

// functions & recursion
fn power(base, exp) {
  if (exp == 0) {
    return 1
  }
  return base * power(base, exp - 1)
}

print("2^10 =", power(2, 10))
print()

// closures
multiplier = 3

fn multiply(x) {
  return x * multiplier
}

print("multiply(5) with multiplier=3:", multiply(5))
print()

// arrays
numbers = [10, 20, 30, 40, 50]
print("Array:", numbers)
print("First element:", numbers[0])
print("Array length:", len(numbers))
print()

// objects
user = {
  name: "rahul",
  age: 21,
  lang: "axiom"
}

print("User object:", user)
print("User name:", user.name)
print("User age:", user.age)
print()

// conditional logic (no else!)
fn classify(n) {
  if (n < 0) {
    return "negative"
  }
  if (n == 0) {
    return "zero"
  }
  return "positive"
}

print("classify(-5):", classify(-5))
print("classify(0):", classify(0))
print("classify(42):", classify(42))
print()

print("=== End of Showcase ===")

