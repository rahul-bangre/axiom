print("=== Schema Validation Examples ===\n")

// Example 1: Basic type validation
print("1. Number validation:")
NumberSchema = schema.number().min(0).max(100)
result1 = NumberSchema.parse(42)
print("Valid: " + typeof(result1))

// Example 2: String validation
print("\n2. String validation:")
NameSchema = schema.string().min(1).max(50)
result2 = NameSchema.parse("Alice")
print("Valid name: " + result2)

// Example 3: Object validation
print("\n3. User object validation:")
UserSchema = schema.object({
  name: schema.string().min(1),
  age: schema.number().min(0).max(150),
  email: schema.string().min(5)
})

user = {name: "Bob", age: 30, email: "bob@example.com"}
validated_user = UserSchema.parse(user)
print("Valid user: " + typeof(validated_user))

// Example 4: Array validation
print("\n4. Array validation:")
NumberArraySchema = schema.array(schema.number()).min(1).max(5)
numbers = [1, 2, 3, 4, 5]
validated_array = NumberArraySchema.parse(numbers)
print("Valid array with " + len(validated_array) + " elements")

// Example 5: Optional fields
print("\n5. Optional field validation:")
ProfileSchema = schema.object({
  username: schema.string().min(3),
  bio: schema.optional(schema.string()),
  age: schema.optional(schema.number())
})

profile1 = {username: "alice", bio: "Developer", age: 25}
validated1 = ProfileSchema.parse(profile1)
print("Profile with all fields: valid")

profile2 = {username: "bob"}
validated2 = ProfileSchema.parse(profile2)
print("Profile with only username: valid")

// Example 6: Nested objects
print("\n6. Nested object validation:")
AddressSchema = schema.object({
  street: schema.string(),
  city: schema.string(),
  zip: schema.number()
})

PersonSchema = schema.object({
  name: schema.string(),
  address: schema.object({
    street: schema.string(),
    city: schema.string(),
    zip: schema.number()
  })
})

person = {
  name: "Charlie",
  address: {
    street: "123 Main St",
    city: "Boston",
    zip: 12345
  }
}
validated_person = PersonSchema.parse(person)
print("Nested object: valid")

// Example 7: JSON + Schema validation
print("\n7. JSON parsing with validation:")
json_data = '{"name":"Dave","age":35,"active":true}'
parsed = json.parse(json_data)

ApiResponseSchema = schema.object({
  name: schema.string(),
  age: schema.number(),
  active: schema.boolean()
})

validated_api = ApiResponseSchema.parse(parsed)
print("API response validated successfully")

print("\n=== All validations passed! ===")

