// array methods demo

print("=== Array Methods Demo ===")
print()

// create array
nums = [1, 2, 3]
print("Original:", nums)
print()

// push - add to end
nums2 = nums.push(4)
print("After nums.push(4):", nums2)
print("Original unchanged:", nums)
print()

// pop - remove from end
nums3 = nums2.pop()
print("After .pop():", nums3)
print()

// first and last
arr = [10, 20, 30, 40, 50]
print("Array:", arr)
print("arr.first():", arr.first())
print("arr.last():", arr.last())
print()

// slice
sub = arr.slice(1, 4)
print("arr.slice(1, 4):", sub)
print()

// concat
a = [1, 2]
b = [3, 4]
c = a.concat(b)
print("[1,2].concat([3,4]):", c)
print()

// chaining operations
result = [].push(1).push(2).push(3)
print("Chaining .push():", result)
print()

print("=== All arrays are immutable! ===")

