// JSON example - demonstrating json.parse() and json.stringify()

print("=== JSON Parsing ===")

// Parse a simple object
json_str = '{"name":"Alice","age":30,"active":true}'
result = json.parse(json_str)
print("Parsed object:")
print(result)

// Parse an array
json_array = '[1, 2, 3, 4, 5]'
arr = json.parse(json_array)
print("\nParsed array:")
print(arr)

// Parse nested structure
nested_json = '{"user":{"name":"Bob","email":"bob@example.com"},"tags":["dev","admin"]}'
nested = json.parse(nested_json)
print("\nParsed nested structure:")
print(nested)

print("\n=== JSON Stringification ===")

// Stringify an object
person = {
  name: "Charlie",
  age: 25,
  hobbies: ["coding", "reading"]
}
json_output = json.stringify(person)
print("Stringified object:")
print(json_output)

// Stringify an array
numbers = [10, 20, 30, 40, 50]
json_numbers = json.stringify(numbers)
print("\nStringified array:")
print(json_numbers)

print("\n=== Round Trip ===")

// Create data, stringify, parse back
original = {
  id: 123,
  data: {
    values: [1, 2, 3],
    active: true
  }
}

print("Original:")
print(original)

serialized = json.stringify(original)
print("\nSerialized:")
print(serialized)

parsed = json.parse(serialized)
print("\nParsed back:")
print(parsed)

