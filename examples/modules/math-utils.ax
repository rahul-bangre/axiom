export fn factorial(n) {
  if (n <= 1) {
    return 1
  }
  return n * factorial(n - 1)
}

export fn fibonacci(n) {
  if (n <= 1) {
    return n
  }
  return fibonacci(n - 1) + fibonacci(n - 2)
}

export fn is_prime(n) {
  if (n < 2) {
    return false
  }
  i = 2
  fn check_divisor(i) {
    if (i * i > n) {
      return true
    }
    if (n % i == 0) {
      return false
    }
    return check_divisor(i + 1)
  }
  return check_divisor(i)
}

export PI = 3.14159
export E = 2.71828

