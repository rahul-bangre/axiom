use "std:fs" as fs

print("=== File I/O Demo ===")
print("")

test_file = "/tmp/axiom-demo.txt"
log_file = "/tmp/axiom-log.txt"
json_file = "/tmp/axiom-data.json"

print("1. Writing to a file:")
await fs.write(test_file, "Hello from Axiom!")
print("  ✓ Wrote to", test_file)
print("")

print("2. Reading from a file:")
content = await fs.read(test_file)
print("  Content:", content)
print("")

print("3. Checking if file exists:")
exists = await fs.exists(test_file)
print("  File exists:", exists)
print("")

missing = await fs.exists("/tmp/nonexistent.txt")
print("  Non-existent file:", missing)
print("")

print("4. Appending to a file:")
await fs.write(log_file, "Log entry 1\n")
await fs.append(log_file, "Log entry 2\n")
await fs.append(log_file, "Log entry 3\n")

log_content = await fs.read(log_file)
print("  Log file:")
print(log_content)

print("5. Reading lines from a file:")
log_lines = await fs.readLines(log_file)
print("  Number of lines:", len(log_lines))
print("  First line:", log_lines[0])
print("")

print("6. Working with JSON:")
user_data = {
  name: "Alice",
  age: 25,
  email: "alice@example.com",
  active: true
}

await fs.writeJson(json_file, user_data, 2)
print("  ✓ Wrote JSON to", json_file)

loaded_data = await fs.readJson(json_file)
print("  Loaded name:", loaded_data.name)
print("  Loaded age:", loaded_data.age)
print("")

print("7. Processing a file:")
lines = await fs.readLines(log_file)

fn count_entries(lines_arr, i, count) {
  if (i >= len(lines_arr)) {
    return count
  }
  
  line = lines_arr[i]
  new_count = line.includes("Log entry") ? count + 1 : count
  return count_entries(lines_arr, i + 1, new_count)
}

entry_count = count_entries(lines, 0, 0)
print("  Found", entry_count, "log entries")
print("")

print("8. Creating a report:")
report_line1 = "=== Axiom Report ===\n"
report_line2 = report_line1 + "Generated by Axiom\n"
report_line3 = report_line2 + "Files processed: 3\n"
report_line4 = report_line3 + "\nFile Details:\n"
report_line5 = report_line4 + "- " + test_file + "\n"
report_line6 = report_line5 + "- " + log_file + "\n"
report = report_line6 + "- " + json_file + "\n"

report_file = "/tmp/axiom-report.txt"
await fs.write(report_file, report)
print("  ✓ Created report at", report_file)
print("")

print("9. Safe file operations with error handling:")
exists1 = await fs.exists(test_file)
result1 = exists1 ? await fs.read(test_file) : null
print("  Read existing file:", result1 != null)

exists2 = await fs.exists("/tmp/missing.txt")
result2 = exists2 ? await fs.read("/tmp/missing.txt") : null
if (result2 == null) {
  print("  ⚠ File does not exist: /tmp/missing.txt")
}
print("  Read missing file:", result2 != null)
print("")

print("10. Cleaning up:")
await fs.delete(test_file)
print("  ✓ Deleted", test_file)

await fs.delete(log_file)
print("  ✓ Deleted", log_file)

await fs.delete(json_file)
print("  ✓ Deleted", json_file)

await fs.delete(report_file)
print("  ✓ Deleted", report_file)
print("")

print("=== Demo Complete ===")
print("")
print("The fs module provides:")
print("- fs.read(path) - Read file as string")
print("- fs.write(path, content) - Write string to file")
print("- fs.append(path, content) - Append to file")
print("- fs.exists(path) - Check if file exists")
print("- fs.delete(path) - Delete file")
print("- fs.readLines(path) - Read file as array of lines")
print("- fs.readJson(path) - Read and parse JSON file")
print("- fs.writeJson(path, data, indent?) - Write object as JSON")

