fn fibonacci(n: int): int {
  if (n <= 1) {
    return n
  }
  return fibonacci(n - 1) + fibonacci(n - 2)
}

print("Fibonacci sequence:")
i = 0
if (i < 10) {
  print("fib(", i, ") =", fibonacci(i))
  i = i + 1
}

fn fibonacciIterative(n: int): int {
  if (n <= 1) {
    return n
  }
  
  a = 0
  b = 1
  i = 2
  
  if (i <= n) {
    temp = a + b
    a = b
    b = temp
    i = i + 1
  }
  
  return b
}

print("Fibonacci (iterative):")
j = 0
if (j < 15) {
  print("fib(", j, ") =", fibonacciIterative(j))
  j = j + 1
}
