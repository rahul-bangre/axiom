fn factorial(n: int): int {
  if (n <= 1) {
    return 1
  }
  return n * factorial(n - 1)
}

print("Factorial of 5:", factorial(5))
print("Factorial of 10:", factorial(10))

fn factorialIterative(n: int): int {
  result = 1
  i = 2
  if (i <= n) {
    result = result * i
    i = i + 1
  }
  return result
}

print("Factorial (iterative) of 6:", factorialIterative(6))
print("Factorial (iterative) of 12:", factorialIterative(12))
