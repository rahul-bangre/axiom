fn factorial(n) {
  if (n <= 1) {
    return 1
  }
  return n * factorial(n - 1)
}

print("Factorial examples:")
print("factorial(0) =", factorial(0))
print("factorial(1) =", factorial(1))
print("factorial(5) =", factorial(5))
print("factorial(10) =", factorial(10))
print("factorial(12) =", factorial(12))
