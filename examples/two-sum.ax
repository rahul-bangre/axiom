/* two sum: find indices of two numbers that add up to target */

fn twoSum(nums, target) {
  fn checkFrom(i) {
    if (i == len(nums)) { return null }
    
    needed = target - nums[i]
    rest = nums.slice(i + 1, len(nums))
    j = rest.findIndex(x => x == needed)
    
    if (j != -1) {
      return [i, i + 1 + j]
    }
    
    return checkFrom(i + 1)
  }
  
  return checkFrom(0)
}

nums = [2, 7, 11, 15]
target = 9
result = twoSum(nums, target)

print("Input:", nums)
print("Target:", target)
print("Indices:", result)
print("Values:", nums[result[0]], "+", nums[result[1]], "=", target)

