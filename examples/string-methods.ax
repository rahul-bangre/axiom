// Axiom String Methods Example
// Comprehensive showcase of string manipulation capabilities

print("=== String Splitting ===")
sentence = "hello world from axiom"
words = sentence.split(" ")
print("Split by space:", words)  // ["hello", "world", "from", "axiom"]

csv = "apple,banana,cherry"
fruits = csv.split(",")
print("CSV split:", fruits)      // ["apple", "banana", "cherry"]

chars = "abc".split()
print("Chars:", chars)            // ["a", "b", "c"]

print("\n=== Trimming Whitespace ===")
messy = "  hello world  "
print("Original:", messy)
print("trim():", messy.trim())           // "hello world"
print("trimStart():", messy.trimStart()) // "hello world  "
print("trimEnd():", messy.trimEnd())     // "  hello world"

print("\n=== Case Conversion ===")
text = "Hello World"
print("Original:", text)
print("toUpperCase():", text.toUpperCase()) // "HELLO WORLD"
print("toLowerCase():", text.toLowerCase()) // "hello world"

print("\n=== String Replacement ===")
greeting = "hello hello world"
print("Original:", greeting)
print("replace():", greeting.replace("hello", "hi"))       // "hi hello world"
print("replaceAll():", greeting.replaceAll("hello", "hi")) // "hi hi world"

print("\n=== String Searching ===")
sentence2 = "the quick brown fox"
print("sentence:", sentence2)
print("startsWith('the'):", sentence2.startsWith("the"))     // true
print("endsWith('fox'):", sentence2.endsWith("fox"))         // true
print("includes('brown'):", sentence2.includes("brown"))     // true
print("indexOf('quick'):", sentence2.indexOf("quick"))       // 4
print("indexOf('missing'):", sentence2.indexOf("missing"))   // -1

print("\n=== Substring & Character Access ===")
text2 = "hello world"
print("substring(0, 5):", text2.substring(0, 5))  // "hello"
print("substring(6):", text2.substring(6))        // "world"
print("charAt(0):", text2.charAt(0))              // "h"
print("charAt(6):", text2.charAt(6))              // "w"

print("\n=== String Repetition ===")
print("'ha'.repeat(3):", "ha".repeat(3))          // "hahaha"
print("'-'.repeat(10):", "-".repeat(10))          // "----------"

print("\n=== Padding ===")
num = "5"
print("padStart(3, '0'):", num.padStart(3, "0"))  // "005"
print("padEnd(3, '0'):", num.padEnd(3, "0"))      // "500"

name = "Alice"
print("padEnd(10):", name.padEnd(10))             // "Alice     "

print("\n=== Array Join ===")
words2 = ["hello", "world"]
joined = words2.join(" ")
print("Join with space:", joined)                 // "hello world"

parts = ["2025", "10", "12"]
date = parts.join("-")
print("Date format:", date)                       // "2025-10-12"

print("\n=== Method Chaining ===")
raw_input = "  HELLO WORLD  "
cleaned = raw_input.trim().toLowerCase()
print("Chained trim + lower:", cleaned)           // "hello world"

print("\n=== Practical Examples ===")

// Title case converter
fn toTitleCase(text: string): string {
  words_arr = text.toLowerCase().split(" ")
  capitalized = words_arr.map((word) => {
    first_char = word.charAt(0).toUpperCase()
    rest = word.substring(1)
    result = first_char + rest
    return result
  })
  return capitalized.join(" ")
}

print("Title case:", toTitleCase("hello world from axiom"))

// Word count
fn countWords(text: string): int {
  trimmed = text.trim()
  words_result = trimmed.split(" ")
  return len(words_result)
}

essay = "The quick brown fox jumps over the lazy dog"
print("Word count:", countWords(essay))

// Email validator (simple)
fn isValidEmail(email: string): bool {
  has_at = email.includes("@")
  has_dot = email.includes(".")
  at_index = email.indexOf("@")
  dot_index = email.lastIndexOf(".")
  
  valid = has_at && has_dot && at_index > 0 && dot_index > at_index
  return valid
}

print("Valid email:", isValidEmail("user@example.com"))    // true
print("Invalid email:", isValidEmail("invalid.email"))     // false

// URL slug generator
fn slugify(text: string): string {
  lower = text.toLowerCase()
  trimmed = lower.trim()
  slug = trimmed.replaceAll(" ", "-")
  return slug
}

print("Slug:", slugify("  Hello World From Axiom  "))

// Palindrome checker
fn isPalindrome(text: string): bool {
  cleaned = text.toLowerCase().replaceAll(" ", "")
  chars_arr = cleaned.split()
  reversed = chars_arr.reverse()
  reversed_str = reversed.join("")
  return cleaned == reversed_str
}

print("Is palindrome 'racecar':", isPalindrome("racecar"))  // true
print("Is palindrome 'hello':", isPalindrome("hello"))      // false

print("\n=== String Utilities Summary ===")
print("✓ split()       - Split string into array")
print("✓ join()        - Join array into string")
print("✓ trim()        - Remove whitespace")
print("✓ toUpperCase() - Convert to uppercase")
print("✓ toLowerCase() - Convert to lowercase")
print("✓ replace()     - Replace first occurrence")
print("✓ replaceAll()  - Replace all occurrences")
print("✓ startsWith()  - Check prefix")
print("✓ endsWith()    - Check suffix")
print("✓ includes()    - Check substring")
print("✓ indexOf()     - Find position")
print("✓ substring()   - Extract substring")
print("✓ charAt()      - Get character at index")
print("✓ repeat()      - Repeat string")
print("✓ padStart()    - Pad from start")
print("✓ padEnd()      - Pad from end")

