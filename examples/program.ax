// Binary Tree with Recursive Schema Validation using schema.lazy()

NodeSchema = schema.object({
  value: schema.number(),
  left: schema.optional(schema.lazy(() => NodeSchema)),
  right: schema.optional(schema.lazy(() => NodeSchema))
})

fn maxDepth(root) {
  if (root == null) {
    return 0
  }

  left_depth = maxDepth(root.left)
  right_depth = maxDepth(root.right)

  return (left_depth > right_depth) ? left_depth + 1 : right_depth + 1
}

fn createNode(val, left, right) {
  node = {value: val, left: left, right: right}
  return NodeSchema.parse(node)
}

print("=== Maximum Depth of Binary Tree ===")
print("(with schema validation)\n")

// Test 1: Single node
tree1 = createNode(1, null, null)
print("Test 1 - Single node")
print("Depth: " + maxDepth(tree1))

// Test 2: Balanced tree depth 3
//       3
//      / \
//     9  20
//       /  \
//      15   7
tree2 = createNode(3,
  createNode(9, null, null),
  createNode(20,
    createNode(15, null, null),
    createNode(7, null, null)
  )
)
print("\nTest 2 - Balanced tree")
print("Depth: " + maxDepth(tree2))

// Test 3: Left-skewed tree depth 4
tree3 = createNode(1,
  createNode(2,
    createNode(3,
      createNode(4, null, null),
      null
    ),
    null
  ),
  null
)
print("\nTest 3 - Left-skewed tree")
print("Depth: " + maxDepth(tree3))

// Test 4: Right-skewed tree
tree4 = createNode(1,
  null,
  createNode(2,
    null,
    createNode(3, null, null)
  )
)
print("\nTest 4 - Right-skewed tree")
print("Depth: " + maxDepth(tree4))

// Test 5: Empty tree
print("\nTest 5 - Empty tree")
print("Depth: " + maxDepth(null))

// Test 6: Complex tree
//         1
//        / \
//       2   3
//      /   / \
//     4   5   6
//    /
//   7
tree6 = createNode(1,
  createNode(2,
    createNode(4,
      createNode(7, null, null),
      null
    ),
    null
  ),
  createNode(3,
    createNode(5, null, null),
    createNode(6, null, null)
  )
)
print("\nTest 6 - Complex unbalanced tree")
print("Depth: " + maxDepth(tree6))
