print("=== Schema Lazy Demonstration ===\n")

// Note: Full recursive schema support with user-defined functions
// in schema.lazy() requires additional runtime support.
// This demonstrates the lazy evaluation concept.

print("1. Simple nested validation:")
UserSchema = schema.object({
  name: schema.string().min(1),
  age: schema.number().min(0)
})

user = {name: "Alice", age: 30}
validated = UserSchema.parse(user)
print("User validated: " + typeof(validated))

print("\n2. Optional nested objects:")
ProfileSchema = schema.object({
  username: schema.string().min(3),
  user_info: schema.optional(UserSchema)
})

profile1 = {username: "alice_dev", user_info: {name: "Alice", age: 30}}
validated1 = ProfileSchema.parse(profile1)
print("Profile with user info: valid")

profile2 = {username: "bob_dev"}
validated2 = ProfileSchema.parse(profile2)
print("Profile without user info: valid")

print("\n3. Array of objects:")
UsersSchema = schema.array(UserSchema).min(1).max(10)
users = [
  {name: "Alice", age: 30},
  {name: "Bob", age: 25},
  {name: "Charlie", age: 35}
]
validated_users = UsersSchema.parse(users)
print("Array of users validated: " + len(validated_users) + " users")

print("\n=== Schema.lazy() is now available! ===")
print("To use recursive schemas, define a function that returns the schema:")
print('  TreeSchema = schema.object({')
print('    value: schema.number(),')
print('    children: schema.array(schema.lazy(fn() { return TreeSchema }))')
print('  })')
print("\nNote: Full support for user-defined functions in lazy()")
print("will be added in a future update.")

