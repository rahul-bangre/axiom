use "./graph.ax" exposing { get_neighbors }

export fn topological_sort(graph, visit_fn) {
  visited = set()
  result_stack = []

  fn visit(node, vis, stack) {
    if (vis.has(node)) {
      return { visited: vis, stack: stack }
    }

    visit_fn(node)

    new_visited = vis.add(node)
    neighbors = get_neighbors(graph, node)

    fn process_neighbors(i, v, s) {
      if (i >= len(neighbors)) {
        return { visited: v, stack: s }
      }

      neighbor = neighbors[i].to
      result = visit(neighbor, v, s)

      return process_neighbors(i + 1, result.visited, result.stack)
    }

    result = process_neighbors(0, new_visited, stack)
    new_stack = [node].concat(result.stack)

    return { visited: result.visited, stack: new_stack }
  }

  fn visit_all(nodes, i, vis, stack) {
    if (i >= len(nodes)) {
      return stack
    }

    node = nodes[i]

    if (!vis.has(node)) {
      result = visit(node, vis, stack)
      return visit_all(nodes, i + 1, result.visited, result.stack)
    }

    return visit_all(nodes, i + 1, vis, stack)
  }

  return visit_all(graph.nodes, 0, visited, result_stack)
}

export fn has_cycle(graph) {
  fn is_cyclic(node, visited, rec_stack) {
    if (rec_stack.has(node)) {
      return { has_cycle: true, visited: visited }
    }
    
    if (visited.has(node)) {
      return { has_cycle: false, visited: visited }
    }
    
    new_visited = visited.add(node)
    new_rec_stack = rec_stack.add(node)
    
    neighbors = get_neighbors(graph, node)
    
    fn check_neighbors(i, vis) {
      if (i >= len(neighbors)) {
        return { has_cycle: false, visited: vis }
      }
      
      neighbor = neighbors[i].to
      result = is_cyclic(neighbor, vis, new_rec_stack)
      
      if (result.has_cycle) {
        return result
      }
      
      return check_neighbors(i + 1, result.visited)
    }
    
    return check_neighbors(0, new_visited)
  }
  
  fn check_all_nodes(nodes, i, visited) {
    if (i >= len(nodes)) {
      return false
    }
    
    node = nodes[i]
    result = is_cyclic(node, visited, set())
    
    if (result.has_cycle) {
      return true
    }
    
    return check_all_nodes(nodes, i + 1, result.visited)
  }
  
  return check_all_nodes(graph.nodes, 0, set())
}

