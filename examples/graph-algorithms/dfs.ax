use "./graph.ax" exposing { get_neighbors }

export fn dfs(graph, start, visit_fn) {
  visited = []
  
  fn visit(node, vis) {
    already_visited = vis.some((v) => v == node)
    if (already_visited) {
      return vis
    }
    
    visit_fn(node)
    
    new_visited = vis.concat([node])
    neighbors = get_neighbors(graph, node)
    
    fn process_neighbors(i, v) {
      if (i >= len(neighbors)) {
        return v
      }
      
      neighbor = neighbors[i].to
      updated_visited = visit(neighbor, v)
      
      return process_neighbors(i + 1, updated_visited)
    }
    
    return process_neighbors(0, new_visited)
  }
  
  return visit(start, visited)
}

export fn dfs_path(graph, start, end, visit_fn) {
  fn find_path(node, target, visited, path) {
    already_visited = visited.some((v) => v == node)
    if (already_visited) {
      return null
    }
    
    visit_fn(node)
    
    new_visited = visited.concat([node])
    new_path = path.concat([node])
    
    if (node == target) {
      return new_path
    }
    
    neighbors = get_neighbors(graph, node)
    
    fn try_neighbors(i) {
      if (i >= len(neighbors)) {
        return null
      }
      
      neighbor = neighbors[i].to
      result = find_path(neighbor, target, new_visited, new_path)
      
      if (result != null) {
        return result
      }
      
      return try_neighbors(i + 1)
    }
    
    return try_neighbors(0)
  }
  
  return find_path(start, end, [], [])
}

