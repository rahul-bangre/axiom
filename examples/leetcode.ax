/* leetcode-style problems solved in axiom
   demonstrating functional problem-solving approaches */

print("=== PROBLEM SOLVING IN AXIOM ===\n")

// ========== PROBLEM 1: TWO SUM ==========
/* given an array of integers and a target, return indices of two numbers
   that add up to the target. you may assume each input has exactly one solution. */

print("Problem 1: Two Sum")
print("Input: [2, 7, 11, 15], target = 9")

fn twoSum(nums, target) {
  fn helper(i) {
    if (i >= len(nums)) {
      return null
    }
    
    current = nums[i]
    remaining = target - current
    
    rest = nums.slice(i + 1, len(nums))
    found_index = rest.findIndex((n) => n == remaining)
    
    if (found_index != -1) {
      return [i, i + 1 + found_index]
    }
    
    return helper(i + 1)
  }
  
  return helper(0)
}

result1 = twoSum([2, 7, 11, 15], 9)
print("Output:", result1)
print("Explanation: nums[0] + nums[1] = 2 + 7 = 9\n")

// ========== PROBLEM 2: VALID ANAGRAM ==========
/* given two strings, determine if they are anagrams of each other */

print("Problem 2: Valid Anagram")
print("Input: 'listen', 'silent'")

fn isAnagram(s1, s2) {
  if (len(s1) != len(s2)) {
    return false
  }
  
  chars1 = s1.split().sort().join("")
  chars2 = s2.split().sort().join("")
  
  return chars1 == chars2
}

result2 = isAnagram("listen", "silent")
print("Output:", result2)
print("Explanation: both contain same letters\n")

// ========== PROBLEM 3: LONGEST WORD ==========
/* find the longest word in a sentence */

print("Problem 3: Longest Word")
sentence = "the quick brown fox jumped over the lazy dog"
print("Input:", sentence)

fn longestWord(text) {
  words = text.split(" ")
  
  longest = words.reduce((acc, word) => {
    if (len(word) > len(acc)) {
      return word
    }
    return acc
  }, "")
  
  return longest
}

result3 = longestWord(sentence)
print("Output:", result3, "\n")

// ========== PROBLEM 4: PALINDROME NUMBER ==========
/* determine if an integer is a palindrome without converting to string */

print("Problem 4: Palindrome Number")
print("Input: 12321")

fn isPalindromeNum(n) {
  if (n < 0) {
    return false
  }
  
  fn reverse(num, acc) {
    if (num == 0) {
      return acc
    }
    return reverse(num / 10, acc * 10 + (num % 10))
  }
  
  reversed = reverse(n, 0)
  return n == reversed
}

result4 = isPalindromeNum(12321)
print("Output:", result4)
print("Explanation: reads same forwards and backwards\n")

// ========== PROBLEM 5: REMOVE DUPLICATES ==========
/* remove duplicates from sorted array and return new length */

print("Problem 5: Remove Duplicates from Sorted Array")
print("Input: [1, 1, 2, 2, 3, 4, 4, 5]")

fn removeDuplicates(nums) {
  unique = nums.reduce((acc, num) => {
    if (len(acc) == 0) {
      return [num]
    }
    
    last = acc[len(acc) - 1]
    if (num != last) {
      return acc.push(num)
    }
    return acc
  }, [])
  
  return unique
}

result5 = removeDuplicates([1, 1, 2, 2, 3, 4, 4, 5])
print("Output:", result5, "\n")

// ========== PROBLEM 6: FIZZBUZZ ==========
/* print numbers 1 to n, but for multiples of 3 print "fizz",
   for multiples of 5 print "buzz", for multiples of both print "fizzbuzz" */

print("Problem 6: FizzBuzz (1-20)")

fn fizzbuzz(n) {
  fn helper(i) {
    if (i > n) {
      return null
    }
    
    div_by_3 = i % 3 == 0
    div_by_5 = i % 5 == 0
    
    output = match(true,
      div_by_3 && div_by_5 -> "fizzbuzz",
      div_by_3 -> "fizz",
      div_by_5 -> "buzz",
      default -> i
    )
    
    print(output)
    return helper(i + 1)
  }
  
  return helper(1)
}

fizzbuzz(20)
print("")

// ========== PROBLEM 7: MERGE SORTED ARRAYS ==========
/* merge two sorted arrays into one sorted array */

print("Problem 7: Merge Two Sorted Arrays")
print("Input: [1, 3, 5, 7], [2, 4, 6, 8]")

fn mergeSorted(arr1, arr2) {
  fn merge(a1, a2, result) {
    len1 = len(a1)
    len2 = len(a2)
    
    if (len1 == 0) {
      return result.concat(a2)
    }
    if (len2 == 0) {
      return result.concat(a1)
    }
    
    first1 = a1[0]
    first2 = a2[0]
    
    if (first1 <= first2) {
      new_result = result.push(first1)
      rest1 = a1.slice(1, len1)
      return merge(rest1, a2, new_result)
    }
    
    new_result = result.push(first2)
    rest2 = a2.slice(1, len2)
    return merge(a1, rest2, new_result)
  }
  
  return merge(arr1, arr2, [])
}

result7 = mergeSorted([1, 3, 5, 7], [2, 4, 6, 8])
print("Output:", result7, "\n")

// ========== PROBLEM 8: GROUP ANAGRAMS ==========
/* group strings that are anagrams of each other */

print("Problem 8: Group Anagrams")
words = ["eat", "tea", "tan", "ate", "nat", "bat"]
print("Input:", words)

fn groupAnagrams(strs) {
  fn sortString(s: string): string {
    return s.split().sort().join("")
  }
  
  grouped = strs.reduce((acc, word) => {
    sorted = sortString(word)
    
    existing = acc.find((group) => {
      first = group[0]
      return sortString(first) == sorted
    })
    
    if (existing == null) {
      return acc.push([word])
    }
    
    return acc.map((group) => {
      first = group[0]
      if (sortString(first) == sorted) {
        return group.push(word)
      }
      return group
    })
  }, [])
  
  return grouped
}

result8 = groupAnagrams(words)
print("Output:", result8, "\n")

// ========== PROBLEM 9: MAXIMUM SUBARRAY SUM ==========
/* find the contiguous subarray with largest sum (kadane's algorithm) */

print("Problem 9: Maximum Subarray Sum")
print("Input: [-2, 1, -3, 4, -1, 2, 1, -5, 4]")

fn maxSubArray(nums) {
  fn kadane(i, current_sum, max_sum) {
    if (i >= len(nums)) {
      return max_sum
    }
    
    num = nums[i]
    new_current = (current_sum + num > num) ? (current_sum + num) : num
    
    new_max = (new_current > max_sum) ? new_current : max_sum
    
    return kadane(i + 1, new_current, new_max)
  }
  
  first = nums[0]
  return kadane(1, first, first)
}

result9 = maxSubArray([-2, 1, -3, 4, -1, 2, 1, -5, 4])
print("Output:", result9)
print("Explanation: [4, -1, 2, 1] has the largest sum = 6\n")

// ========== PROBLEM 10: PRODUCT EXCEPT SELF ==========
/* return array where each element is product of all other elements */

print("Problem 10: Product of Array Except Self")
print("Input: [1, 2, 3, 4]")

fn productExceptSelf(nums) {
  len_nums = len(nums)
  
  fn helper(i, acc) {
    if (i >= len_nums) {
      return acc
    }
    
    left = nums.slice(0, i)
    right = nums.slice(i + 1, len_nums)
    all_others = left.concat(right)
    
    product = all_others.reduce((p, n) => p * n, 1)
    new_acc = acc.push(product)
    
    return helper(i + 1, new_acc)
  }
  
  return helper(0, [])
}

result10 = productExceptSelf([1, 2, 3, 4])
print("Output:", result10)
print("Explanation: [24, 12, 8, 6]\n")
