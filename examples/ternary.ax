/* ternary expressions showcase */

// basic usage
age = 20
status = age >= 18 ? "adult" : "minor"
print("Status:", status)

// nested ternary
score = 85
grade = score >= 90 ? "A" : score >= 80 ? "B" : score >= 70 ? "C" : "F"
print("Grade:", grade)

// with function calls
fn abs(x) {
  return x >= 0 ? x : -x
}
print("abs(-5):", abs(-5))
print("abs(10):", abs(10))

// in array operations
nums = [1, 2, 3, 4, 5]
result = nums.map(x => x % 2 == 0 ? x * 10 : x)
print("Transformed:", result)

// max function using ternary
fn max(a, b) {
  return a > b ? a : b
}
print("max(15, 27):", max(15, 27))

// clamp function with nested ternaries
fn clamp(value, min, max) {
  return value < min ? min : value > max ? max : value
}
print("clamp(5, 10, 20):", clamp(5, 10, 20))
print("clamp(15, 10, 20):", clamp(15, 10, 20))
print("clamp(25, 10, 20):", clamp(25, 10, 20))

