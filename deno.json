{
  "tasks": {
    "start": "deno run --allow-read src/cli.ts",
    "run": "deno run --allow-read src/cli.ts",
    "test": "deno test --allow-read",
    "dev": "deno run --watch --allow-read src/cli.ts"
  },
  "imports": {
    "@lexer": "./src/lexer/mod.ts",
    "@parser": "./src/parser/mod.ts",
    "@interpreter": "./src/interpreter/mod.ts",
    "@runtime": "./src/runtime/mod.ts",
    "@types": "./src/types/mod.ts",
    "@std": "./src/std/mod.ts"
  },
  "compilerOptions": {
    "strict": true,
    "lib": ["deno.window"]
  },
  "fmt": {
    "indentWidth": 2,
    "lineWidth": 100
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  }
}
