{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Axiom",
  "scopeName": "source.axiom",
  "patterns": [
    {"include": "#comments"},
    {"include": "#keywords"},
    {"include": "#strings"},
    {"include": "#numbers"},
    {"include": "#functions"},
    {"include": "#types"},
    {"include": "#operators"},
    {"include": "#constants"},
    {"include": "#punctuation"}
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.axiom",
          "match": "//.*$"
        },
        {
          "name": "comment.block.axiom",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.axiom",
          "match": "\\b(if|return)\\b"
        },
        {
          "name": "keyword.other.axiom",
          "match": "\\b(fn|type|typeof)\\b"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.axiom",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.axiom",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.axiom",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.axiom",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.axiom",
          "match": "\\b0[xX][0-9a-fA-F]+\\b"
        },
        {
          "name": "constant.numeric.float.axiom",
          "match": "\\b[0-9]+\\.[0-9]+\\b"
        },
        {
          "name": "constant.numeric.integer.axiom",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.axiom",
          "match": "\\b(fn)\\s+([a-z_][a-z0-9_]*)\\b",
          "captures": {
            "1": {"name": "keyword.other.axiom"},
            "2": {"name": "entity.name.function.axiom"}
          }
        },
        {
          "name": "entity.name.function.call.axiom",
          "match": "\\b([a-z_][a-z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": {"name": "entity.name.function.axiom"}
          }
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.axiom",
          "match": "\\b(int|float|string|bool|boolean|null|void|array|object|function|any)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.logical.axiom",
          "match": "&&|\\|\\||!"
        },
        {
          "name": "keyword.operator.comparison.axiom",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.assignment.axiom",
          "match": "="
        },
        {
          "name": "keyword.operator.arithmetic.axiom",
          "match": "\\+|-|\\*|/|%"
        },
        {
          "name": "keyword.operator.ternary.axiom",
          "match": "\\?|:"
        },
        {
          "name": "keyword.operator.arrow.axiom",
          "match": "=>"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.axiom",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.null.axiom",
          "match": "\\bnull\\b"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.definition.block.axiom",
          "match": "[{}]"
        },
        {
          "name": "punctuation.definition.parameters.axiom",
          "match": "[()]"
        },
        {
          "name": "punctuation.definition.array.axiom",
          "match": "[\\[\\]]"
        },
        {
          "name": "punctuation.separator.comma.axiom",
          "match": ","
        },
        {
          "name": "punctuation.accessor.axiom",
          "match": "\\."
        }
      ]
    }
  }
}



